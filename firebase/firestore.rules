rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{username} {
      allow read, write: if true; // open access for now
    }

    match /game_saves/{userId} {
      allow read, write: if true;
    }

    // WigTube collection with map-based documents
    match /wigtube/data {
      allow read: if true; // Anyone can read
      allow write: if true; // Anyone can write (for now - should be restricted later)
      
      // WigTube videos subcollection
      match /videos/{videoId} {
        allow read: if true; // Anyone can read videos
        allow create: if true; // Anyone can create videos (for now)
        allow update: if true; // Anyone can update (for views/ratings)
        allow delete: if true; // Anyone can delete (should be restricted to owner)
      }
      
      // WigTube user data (history, favorites) subcollection
      match /userdata/{username} {
        allow read: if true; // Anyone can read (client filters by username)
        allow write: if true; // Anyone can write (client validates username)
      }
      
      // WigTube playlists subcollection (moved from top-level)
      match /playlists/{playlistId} {
        allow read: if true; // Anyone can read playlists (client filters by owner)
        allow create: if true; // Anyone can create playlists (client sets owner field)
        allow update: if true; // Anyone can update playlists (client validates ownership)
        allow delete: if true; // Anyone can delete playlists (client validates ownership)
      }
    }
    
    // Allow access to other wigtube documents
    match /wigtube/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // User achievements collection
    match /user_achievements/{username} {
      allow read, write: if true; // Open access for now
    }

    // Legacy winesweeper badges collection (for backwards compatibility)
    match /winesweeper_badges/{username} {
      allow read, write: if true; // Open access for now
    }
  }
}
